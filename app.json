{
  "expo": {
    "name": "MiPensionL73",
    "slug": "mi-pension-l73",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vieyralabs.mipensionl73",
      "infoPlist": {
        "CFBundleDisplayName": "Mi Pensión L73"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#047857"
      },
      "package": "com.vieyralabs.mipensionl73"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidAppName",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#047857",
          "image": "./src/assets/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "scheme": "mipension",
    "extra": {
      "eas": {
        "projectId": "5fd386e2-77d0-4b5c-a26d-038482f804bd"
      }
    },
    "owner": "alanvieyra333",
    "updates": {
      "url": "https://u.expo.dev/5fd386e2-77d0-4b5c-a26d-038482f804bd"
    }
  }
}
